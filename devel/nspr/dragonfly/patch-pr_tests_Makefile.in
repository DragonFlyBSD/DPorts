--- pr/tests/Makefile.in.orig
+++ pr/tests/Makefile.in
@@ -276,6 +276,12 @@
 
 ifeq ($(OS_ARCH),OpenUNIX)
 export LD_RUN_PATH = $(ABSOLUTE_LIB_DIR)
+ifeq ($(USE_PTHREADS),1)
+LDOPTS += -pthread
+endif
+endif
+
+ifeq ($(OS_ARCH),DragonFly)
 ifeq ($(USE_PTHREADS),1)
 LDOPTS += -pthread
 endif
@@ -309,7 +315,7 @@
 ifeq ($(OS_ARCH),AIX)
 LIBPTHREAD = -lpthreads
 endif
-ifeq (,$(filter-out FreeBSD OpenBSD BSD_OS QNX Darwin OpenUNIX Redox,$(OS_ARCH)))
+ifeq (,$(filter-out DragonFly FreeBSD OpenBSD BSD_OS QNX Darwin OpenUNIX Redox,$(OS_ARCH)))
 LIBPTHREAD =
 endif
 endif
